{
  "name": "survay",
  "version": "0.2.0",
  "private": true,
  "description": "A small survey you run yourself: one Bun process, one SQLite file, one question at a time.",
  "license": "MIT",
  "bin": {
    "survay": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "survay": "bun src/cli.ts",
    "dev": "bun --watch src/cli.ts serve",
    "check": "tsc -p . && oxlint --type-aware && oxfmt --check && bun test",
    "fix": "oxlint --type-aware --fix && oxfmt"
  },
  "dependencies": {
    "bun-plugin-tailwind": "0.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
